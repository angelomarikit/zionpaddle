# Supabase (Phase 4 — run supabase/migrations/001_orders_core.sql first)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Phase 5 admin at /admin. On Vercel: set with Supabase vars and REDEPLOY (Vite embeds env at build).
# Omit or true to enable when Supabase is set; set false to hide admin on a connected storefront.
VITE_ENABLE_ADMIN=false

# Optional — absolute OG/social URLs (e.g. https://yourdomain.com). Leave empty for relative /og.jpg.
# VITE_SITE_URL=https://yourdomain.com